[Unit]
Description=Private AI Inbox
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/lib/ai-inbox/deploy-start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
TimeoutStopFailureMode=kill
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
